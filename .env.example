# Copy to .env and fill in; never commit .env. Read by `make download` (scripts/fetch/challenge.py).
# Team keys from the organizer acceptance e-mail (PRC Data Challenge 2026, OpenSky S3 / MinIO).
ACCESS_KEY=
SECRET_KEY=
# Optional (defaults shown):
# S3_ENDPOINT=s3.opensky-network.org:443
# DATASET_BUCKET=prc-2026-datasets
# Team upload bucket and name, used only for submissions (not by the pipeline):
# TEAM_NAME=
# BUCKET_NAME=
